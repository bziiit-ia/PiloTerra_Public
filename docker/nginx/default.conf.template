# PiloTerra — configuration Nginx
# -------------------------------
# Gabarit passé dans envsubst au démarrage du conteneur (image
# nginx-unprivileged). Seules les variables d'environnement DÉFINIES sont
# substituées : les variables Nginx ($uri, $host…) restent intactes.
#
# HTTPS, certificats et nom de domaine sont gérés en amont par Traefik,
# le proxy de Dokploy. Nginx ne voit que du HTTP interne sur le port 8080.

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    # Derrière Traefik : pas de redirection absolue vers http://…:8080
    absolute_redirect off;

    # --- Compression --------------------------------------------------
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types
        text/plain text/css text/xml application/xml
        application/javascript application/json
        image/svg+xml;

    # --- En-têtes communs ---------------------------------------------
    # "noindex, nofollow" par défaut dans l'image de préproduction (voir
    # Dockerfile). Une valeur vide supprime l'en-tête : Nginx n'émet pas un
    # en-tête vide.
    add_header X-Robots-Tag "${X_ROBOTS_TAG}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # --- Sonde de santé (HEALTHCHECK du Dockerfile) --------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- Assets Vite, nommés par empreinte : cache d'un an ------------
    # « ^~ » : ce préfixe l'emporte sur la règle par extension ci-dessous,
    # sinon /assets/index-xxxx.js n'aurait qu'une heure de cache.
    location ^~ /assets/ {
        try_files $uri =404;
        # add_header dans un bloc location annule ceux du bloc server :
        # on les redéclare.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Robots-Tag "${X_ROBOTS_TAG}" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # --- Fichiers statiques non versionnés (favicons, robots, sitemap) -
    # Un fichier absent renvoie une vraie 404, jamais index.html : sinon le
    # navigateur reçoit du HTML à la place d'un CSS ou d'une image.
    location ~* \.(?:css|js|mjs|map|png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|txt|xml|json|webmanifest)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600" always;
        add_header X-Robots-Tag "${X_ROBOTS_TAG}" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # --- Slash final : redirection vers l'URL canonique ---------------
    # /agents/ désigne un dossier sans index : Nginx répondrait 403. On
    # renvoie vers /agents, la forme utilisée par le sitemap. La racine « / »
    # n'est pas concernée (au moins un caractère avant le slash).
    location ~ ^(.+)/$ {
        return 301 $1$is_args$args;
    }

    # --- Pages HTML : SPA + pages SEO générées au build ---------------
    # Le plugin SEO écrit des fichiers sans répertoire d'index :
    #   /agents                  → agents.html
    #   /agents/assistant-pac    → agents/assistant-pac.html
    # d'où « $uri.html ». Pas de « $uri/ » : aucun dossier n'a d'index, il
    # ne produirait qu'une 403 ou une redirection vers /agents/.
    # Tout le reste retombe sur index.html : l'application gère ses routes
    # par hash (#prompts, #profile…) et lit elle-même le chemin (seoUrl.ts).
    location / {
        try_files $uri $uri.html /index.html;
        # HTML jamais mis en cache : un redéploiement est visible aussitôt.
        add_header Cache-Control "no-cache" always;
        add_header X-Robots-Tag "${X_ROBOTS_TAG}" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}
