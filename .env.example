# =====================================================================
#  PiloTerra — modèle de configuration
#  Copier ce fichier en .env (exclu de Git), puis le compléter.
#  Il sert au portail (variables VITE_*, lues par Vite) et à la pile
#  locale docker-compose.yml (Supabase + n8n).
#  Relancer `npm run dev` après toute modification.
# =====================================================================

# ---------------------------------------------------------------------
#  Portail
#  Valeurs par défaut : la pile locale (docker compose up).
# ---------------------------------------------------------------------

# Adresse du projet Supabase (sans barre finale)
VITE_SUPABASE_URL=http://localhost:8000

# Clé anon (publique) du projet. JAMAIS la clé service_role : elle
# contourne toute la sécurité de la base et finirait dans le JavaScript.
# En local : la même valeur que ANON_KEY plus bas.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzYwNDg2NDAwLCJleHAiOjIwNzU4NDY0MDB9.ufHUf4pUGXJljVfVwSTBVeedtIcVedoGayFrUhQT3Ho

# Scénarios n8n : dev = chemins préfixés « dev- », prod = chemins nus
VITE_N8N_ENVIRONNEMENT=dev

# Adresse de l'instance n8n (sans barre finale). Par défaut, si la ligne
# est absente : https://n8n.bziiit.com
VITE_N8N_URL=http://localhost:5678


# ---------------------------------------------------------------------
#  Pile locale — images
#  Par défaut, les versions du Supabase de dev (supabase.piloterra.me).
# ---------------------------------------------------------------------
SUPABASE_POSTGRES_IMAGE=supabase/postgres:17.6.1.136
SUPABASE_AUTH_IMAGE=supabase/gotrue:v2.189.0
SUPABASE_REST_IMAGE=postgrest/postgrest:v14.12
SUPABASE_STORAGE_IMAGE=supabase/storage-api:v1.60.4
SUPABASE_META_IMAGE=supabase/postgres-meta:v0.96.6
SUPABASE_STUDIO_IMAGE=supabase/studio:2026.08.03-sha-022b374
SUPABASE_KONG_IMAGE=kong/kong:3.9.3
N8N_IMAGE=n8nio/n8n:2.43.5


# ---------------------------------------------------------------------
#  Pile locale — Supabase
#  Secrets de POSTE DE DÉVELOPPEMENT, publics puisque dans ce modèle :
#  ne jamais les réutiliser sur une base accessible depuis Internet.
#  Changer JWT_SECRET impose de régénérer ANON_KEY et SERVICE_ROLE_KEY
#  (jetons HS256 signés avec ce secret, rôles anon et service_role).
# ---------------------------------------------------------------------
POSTGRES_PASSWORD=piloterra-local
JWT_SECRET=piloterra-local-jwt-secret-a-changer-hors-poste-de-dev
JWT_EXPIRY=3600
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzYwNDg2NDAwLCJleHAiOjIwNzU4NDY0MDB9.ufHUf4pUGXJljVfVwSTBVeedtIcVedoGayFrUhQT3Ho
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3NjA0ODY0MDAsImV4cCI6MjA3NTg0NjQwMH0.fpAqrh-MO3FqdJyqZeJ5ZlEmxj01-hRgV_MorrwNDdM
PG_META_CRYPTO_KEY=b0f06edade05e5847996654d264d58c8

# Studio (http://localhost:8000), protégé par authentification basique
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=piloterra-local

# Ports exposés sur le poste (127.0.0.1 uniquement)
SUPABASE_PORT=8000
POSTGRES_PORT_LOCAL=54322

# Adresse du portail, pour les liens des e-mails d'authentification
SITE_URL=http://localhost:3000

# Comptes confirmés sans e-mail : aucun serveur SMTP en local
ENABLE_EMAIL_AUTOCONFIRM=true


# ---------------------------------------------------------------------
#  Pile locale — n8n
#  Les scénarios ne sont pas fournis : les importer dans
#  http://localhost:5678, avec des chemins préfixés « dev- ». Depuis n8n,
#  Supabase se joint à http://kong:8000 (clé SERVICE_ROLE_KEY).
# ---------------------------------------------------------------------
N8N_PORT=5678
N8N_ENCRYPTION_KEY=510e13bfef34c8164552716ea99a43a0
